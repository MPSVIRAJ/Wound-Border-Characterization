{
  "DataPaths": {
    "data_path": "./data",
    "metadata_path": "./metadata",
    "output_path": "./outputs",
    "image_manifest_filtered_filename": "image_index_filtered.csv",
    "comprehensive_features_filename": "comprehensive_features.csv",
    "image_cluster_map_filename": "image_cluster_map.csv",      
    "features_with_labels_filename": "features_with_labels.csv"
  },
  "subdirs": {
    "wound_masks_subdir": "wound_masks",
    "images_subdir": "images",
    "body_mask_subdir": "body_masks",
    "depth_maps_subdir": "depth_maps",
    "marker_mask_subdir": "marker_masks"
  },
  "Filtering": {
    "pixel_area_threshold": 15000,
    "max_wound_components": 1
  },
  "FeatureExtraction": {
    "unroll_iterations": 100,
    "transition_width": 50
  },
  "Clustering": {
    "pacmap_n_components": 2,
    "pacmap_mn_ratio": 2,
    "pacmap_fp_ratio": 8,
    "hdbscan_min_cluster_size": 25,
    "hdbscan_min_samples": 6,
    "hdbscan_epsilon": 0.75
  },
  "Classification": {
    "test_size": 0.2,
    "random_state": 42,
    "random_forest_n_estimators": 100
  }
}